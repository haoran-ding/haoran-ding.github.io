<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and news_size > 3 %}
        style="overflow-y: auto;"
        data-visible-rows="{{ site.announcements.visible | default: 10 }}"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | sort: 'date' | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
<script>
  (function () {
    function fitNews() {
      var box = document.querySelector('.news .table-responsive[data-visible-rows]');
      if (!box) return;
      var n = parseInt(box.getAttribute('data-visible-rows'), 10);
      var rows = box.querySelectorAll('tr');
      if (!n || rows.length <= n) return;
      var top = rows[0].getBoundingClientRect().top;
      var bottom = rows[n - 1].getBoundingClientRect().bottom;
      box.style.maxHeight = Math.ceil(bottom - top) + 'px';
    }
    document.addEventListener('DOMContentLoaded', fitNews);
    window.addEventListener('resize', fitNews);
  })();
</script>
